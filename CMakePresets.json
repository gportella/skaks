      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-17",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-17",
        "CMAKE_BUILD_TYPE": "Release",

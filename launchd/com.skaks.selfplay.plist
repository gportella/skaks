<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.skaks.selfplay</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>"$HOME/work/repos/skaks/scripts/self_play_launchd_wrapper.sh start"</string>
    </array>

    <!-- Keep it alive on exit -->
    <key>KeepAlive</key>
    <true/>

    <!-- Run at load (login) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Redirect stdout/stderr to files under ~/Library/Logs/com.skaks.selfplay/ -->
    <key>StandardOutPath</key>
    <string>/Users/$(whoami)/Library/Logs/com.skaks.selfplay/out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/$(whoami)/Library/Logs/com.skaks.selfplay/err.log</string>

    <!-- Limit resource churn -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
</plist>
